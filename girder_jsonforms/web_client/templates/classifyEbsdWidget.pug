.modal-dialog
  .modal-content
    form#g-classify-ebsd(role="form")
      .modal-header
        button.close(type="button", data-dismiss="modal", aria-label="Close")
          span(aria-hidden="true") &times;
        h4.modal-title Classify EBSD Folder
      .modal-body
        p.
          This will classify files in the selected folder recursively by file type and folder naming conventions,
          and assign metadata such as EBSD_Raw, EBSD_Scripts, or EBSD_Derived.
        .g-validation-failed-message
      .modal-footer
        a.btn.btn-small.btn-default(data-dismiss="modal") Close
        button.g-classify-ebsd.btn.btn-small.btn-primary(type="submit") Classify
