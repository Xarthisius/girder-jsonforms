.card-header-embed
  .title-area-embed
    h1
      button.toggle-collapse-btn(type="button", aria-expanded=isExpanded ? "true" : "false", title="Toggle Details View")
        svg.icon-chevron(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", width="16", height="16")
          polyline(points="6 9 12 15 18 9")
        span= title
    .meta-line-embed
      | Published #{year} via 
      em= publisher
  a.doi-badge-embed(href=doiUrl, target="_blank") doi:#{doi}

.collapsible-content
  h2.section-title-embed Authors & Affiliations
  .authors-container-embed
    each creator in creators
      .author-node-embed
        .author-name-embed
          | #{creator.name}
          if creator.orcid_url
            a.orcid-link(href=creator.orcid_url, title="ORCID: " + creator.orcid_id, target="_blank", rel="noopener noreferrer")
              svg.inline-icon.icon-orcid(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="currentColor", aria-hidden="true", width="14", height="14")
                path(d="M21.8 12c0 5.4-4.4 9.8-9.8 9.8S2.2 17.4 2.2 12 6.6 2.2 12 2.2s9.8 4.4 9.8 9.8zM8.2 5.8c-.4 0-.8.3-.8.8s.3.8.8.8.8-.4.8-.8-.3-.8-.8-.8zm2.3 9.6h1.2v-6h1.8c2.3 0 3.3 1.4 3.3 3s-1.5 3-3.3 3h-3v1.1H9V8.3H7.7v8.2h5.9c3.3 0 4.5-2.2 4.5-4.1s-1.2-4.1-4.3-4.1h-3.2l-.1 7.1z")
        if creator.affiliations && creator.affiliations.length > 0
          .author-affs-embed
            each aff, index in creator.affiliations
              span.aff-item-embed
                | #{aff.name}
                if aff.ror_url
                  a.ror-link(href=aff.ror_url, target="_blank", rel="noopener noreferrer", title="Research Organization Registry")
                    svg.inline-icon.icon-ror(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="currentColor", aria-hidden="true", width="13", height="13")
                      path(d="M10 4.2L8.3 6.8 6.6 4.2H10zM17.1 4.2l-1.7 2.6-1.7-2.6h3.4zM6.6 19.8l1.7-2.6 1.7 2.6H6.6zM13.7 19.8l1.7-2.6 1.7 2.6h-3.4zM20.8 12.5c.6-.1 1.1-.4 1.4-.8.3-.4.5-.9.5-1.5 0-.5-.1-.9-.3-1.2-.2-.3-.4-.6-.7-.8-.3-.2-.6-.3-1-.4-.4-.1-.8-.1-1.2-.1h-3.3v2.6c0-.1-.1-.2-.1-.2-.2-.6-.6-1-1-1.4-.4-.4-.9-.7-1.5-.9-.6-.2-1.2-.3-1.9-.3s-1.3.1-1.9.3c-.5.1-1 .4-1.4.8-.3.4-.6.8-.9 1.3 0-.3-.1-.6-.2-.9-.2-.4-.4-.6-.7-.8-.3-.2-.6-.3-1-.4s-.8-.2-1.3-.2H1v8.5h1.9v-3.4h.9l1.8 3.4h2.3l-2.2-3.6c.6-.1 1.1-.4 1.4-.8v-.1.2c0 .7.1 1.3.3 1.8.2.6.6 1 1 1.4.4.4.9.7 1.5.9.6.2 1.2.3 1.9.3s1.3-.1 1.9-.3c.6-.2 1.1-.5 1.5-.9.4-.4.7-.9 1-1.4 0-.1.1-.2.1-.2V16H18v-3.4h.9l1.8 3.4H23l-2.2-3.5zM5.4 10.7c-.1.2-.2.3-.3.3-.2.1-.3.1-.5.1H2.9V9.2h1.7c.2 0 .3.1.5.1.1.1.3.2.3.3.1.1.1.3.1.5.1.3 0 .5-.1.6zm8.8 2.3c-.1.3-.3.6-.5.9-.2.2-.5.4-.8.6-.3.1-.7.2-1.1.2-.4 0-.8-.1-1.1-.2-.3-.1-.6-.3-.8-.6-.2-.2-.4-.5-.5-.9-.1-.3-.2-.7-.2-1.1 0-.4.1-.8.2-1.1s.3-.6.5-.9c.2-.2.5-.4.8-.6.3-.1.7-.2 1.1-.2.4 0 .8.1 1.1.2.3.1.6.3.8.6.2.2.4.5.5.9.1.3.2.7.2 1.1 0 .4 0 .7-.2 1.1zm6.4-2.3c-.1.1-.2.2-.4.3-.2.1-.3.1-.5.1H18V9.2h1.7c.2 0 .3.1.5.1.1.1.3.2.3.3.1.1.1.3.1.5.1.3.1.5 0 .6z")
              if index < creator.affiliations.length - 1
                | , 

  .card-body-embed
    .main-content-embed
      h2.section-title-embed Abstract / Description
      .abstract-embed= abstract

      h2.section-title-embed Subjects & Keywords
      .tag-container-embed
        if subjects && subjects.length > 0
          each subj in subjects
            span.tag-embed= subj
        else
          span.tag-embed(style="background: none; color: var(--text-muted-internal); padding:0;") None listed

      h2.section-title-embed Related Identifiers
      ul.link-list-embed
        if relatedIdentifiers && relatedIdentifiers.length > 0
          each rel in relatedIdentifiers
            li
              | 🔗 
              strong #{rel.type}: 
              a(href=rel.href, target="_blank") #{rel.display} (#{rel.generalType})
        else
          li No related identifiers listed.

    .meta-sidebar-embed
      .meta-item-embed
        span.meta-label-embed Resource Type
        span.meta-value-embed= resourceType
      .meta-item-embed
        span.meta-label-embed Version & Size
        span.meta-value-embed #{version} &bull; #{size}
      .meta-item-embed
        span.meta-label-embed Format
        span.meta-value-embed
          code= format
      .meta-item-embed
        span.meta-label-embed Location
        span.meta-value-embed(title=locationTitle)= locationStr
      .meta-item-embed
        span.meta-label-embed License
        span.meta-value-embed
          a(href=licenseUri, target="_blank")= licenseStr
      .meta-item-embed
        span.meta-label-embed Funding
        .meta-value-embed
          if funding && funding.length > 0
            each fund in funding
              - var titleAttr = fund.awardTitle ? fund.awardTitle : null
              if fund.awardNum
                .funding-entry-embed(title=titleAttr) #{fund.funder} (##{fund.awardNum})
              else
                .funding-entry-embed(title=titleAttr)= fund.funder
          else
            .funding-entry-embed None
