.g-body-title
  if igsn
    | Sample Information for IGSN #{igsn}
  else
    | New Sample Submission
form#g-deposition-form(role="form")
  .g-deposition-form-container
    if !igsn
      .row
        .col-xs-12.col-md-6.col-lg-3
          label(for="g-deposition-governor") Originating Institution
          select.form-control(id="g-deposition-governor" name="governor" required)
            option(value="") Select an institution
            each institution in institutions
              option(value=institution.code)= institution.name
          small.form-text.text-muted
            | The institution where the sample was manufactured or procured.
        .col-xs-12.col-md-6.col-lg-3
          label(for="g-deposition-governorLab") Originating Group
          select.form-control(id="g-deposition-governorLab" name="governorLab")
            option(value="") Select a group
          small.form-text.text-muted
            | The group within the institution. If not applicable, leave blank.
        .col-xs-12.col-md-6.col-lg-3
          label(for="g-deposition-material") Material Type
          select.form-control(id="g-deposition-material" name="material" required)
            option(value="") Select a material type
            each material in materials
              option(value=material[0])= material[1].name
          small.form-text.text-muted
            | The basic type of material following NIST guidelines.
        .col-xs-12.col-md-6.col-lg-3
          label(for="g-deposition-materialType") Material Subtype
          select.form-control(id="g-deposition-materialType" name="materialSubtype" disabled)
            option(value="") Select a material subtype
          small.form-text.text-muted
            | If subtypes are available, select one. Otherwise, leave blank.
    .form-group
      label(for="g-deposition-name") Sample Name
      input.form-control(type="text" id="g-deposition-title" name="title" required)
      small.form-text.text-muted
        | A descriptive, human-readible name of the sample, e.g. "TiO2 100 nm on Si"
    .form-group
      .g-descriptions-container
    .form-group
      .g-creators-container
    .form-group
      .g-related-identifiers-container
    .form-group
      .g-identifiers-container
    if igsn
      .form-group
        label(for="g-sample-id") Associated Sample Tracker
        select.sampleSelect.form-control(
          data-default-text="Search for a Sample Tracker"
          id="g-sample-id"
          name="sampleId"
          autocomplete="off"
        )

    if !igsn
      #g-configuration-accordion.panel-group
        .panel.panel-default
          .panel-heading(data-toggle="collapse"
              data-parent="#g-configuration-accordion"
              data-target="#g-advanced-configuration")
            .panel-title
              a
                b Advanced Settings
          #g-advanced-configuration.panel-collapse.collapse
            .panel-body
              p These settings should only be changed if you are certain of what you are doing.
              .form-group
                .checkbox
                  label
                    input.g-enable-tracking(type="checkbox" checked=true)
                    | Enable Sample Tracking of this IGSN
              .form-group
                label(for="g-deposition-batch") Number of subsamples
                input#g-deposition-batch.form-control(type="number" name="batch" value="0" min="0" max="999")
                small.form-text.text-muted
                  | If the number of subsamples is greater than 0, the additional IGSNs will be generated
                  | with a suffix -001, -002, ... up to N. If 0, a single IGSN will be generated.

  button#g-deposition-cancel.btn.btn-secondary(type="button") Cancel
    button#g-add-deposition-btn.btn.btn-primary(type="submit") Save
  #g-deposition-error-message.g-validation-failed-message
