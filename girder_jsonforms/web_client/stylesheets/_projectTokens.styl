$status-draft-bg = #f1f3f5
$status-review = #8a5a00
$status-review-bg = #fff4d6
$status-accepted = #1f7a45
$status-accepted-bg = #e3f5ea
$status-rejected = #a93226
$status-rejected-bg = #fbe6e4

$border = #e3e6ea
$muted = #6b7480
