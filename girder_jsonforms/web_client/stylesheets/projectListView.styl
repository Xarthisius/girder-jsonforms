@import '_projectTokens'

.g-project-list-container
  max-width 1280px
  padding-bottom 30px

.g-project-list-header
  display flex
  align-items center
  margin-bottom 16px

.g-project-list-title
  margin 0
  font-size 26px
  font-weight 600

.g-project-list-card
  background #fff
  border 1px solid $border
  border-radius 6px
  overflow hidden

.g-project-list-table
  margin-bottom 0

  th
    padding 10px 16px !important
    background #f8f9fb
    color $muted
    font-size 12px
    font-weight 600
    letter-spacing .04em
    text-transform uppercase
    border-bottom 1px solid $border !important

  td
    padding 12px 16px !important
    vertical-align middle !important
    border-top 1px solid $border !important

  tbody tr:first-child td
    border-top none !important

.g-project-row
  cursor pointer
  transition background .12s

  &:hover
    background #f5f9fd

  // Inset shadow rather than a border, so awaiting rows keep their column alignment.
  &.g-project-row-awaiting
    box-shadow inset 4px 0 0 #e0a100

.g-project-row-title
  display flex
  align-items center
  gap 8px

  a
    font-size 15px
    font-weight 600
    color #222

    &:hover
      color #2a6496

.g-project-row-flag
  padding 0 7px
  border-radius 4px
  background $status-review-bg
  color $status-review
  font-size 11px
  font-weight 600

.g-project-row-meta
  margin-top 2px
  color $muted
  font-size 12px

.g-project-row-id
  font-family monospace
  font-weight 600
  color #444

.g-project-row-sep
  margin 0 6px

.g-project-row-num,
.g-project-row-date
  color #444
  white-space nowrap
  font-variant-numeric tabular-nums

.g-project-list-empty
  padding 40px 16px
  background #fff
  border 1px dashed $border
  border-radius 6px
  color $muted
  text-align center
  font-style italic

.g-project-pagination
  margin-top 12px
